{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vietnamese's Ultimate W App",
  "version": "../package.json",
  "mainBinaryName": "fomeg-windows-app",
  "identifier": "com.fomeg.windows-app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:mcp && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Vietnamese's Ultimate W App",
        "width": 1320,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#1b1b1f"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
